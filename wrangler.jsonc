    "MAIL_TRANSPORT": "brevo-api",
    "BREVO_FROM": "kywsf2582@gmail.com",
    "BREVO_SENDER_NAME": "تطبيق البرازيلي",
    "ADMIN_EMAIL": "kywsf2582@gmail.com"
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "838d3f9018cb4e7bb79d2007c6aef1b4" }
  ]
